# Copy to backend/.env and fill in. Never commit the real .env.
DATABASE_URL=postgresql://user:password@localhost:5432/and_you

# LLM providers (centralize usage in one backend config module)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default judge/structured-output model (app/features/* judges) + temperature.
# Judge is COLD by default for reproducible verdicts.
LLM_MODEL=gpt-4o-mini
JUDGE_TEMPERATURE=0.0

# Per-request OpenAI timeout (seconds) + retry cap. Bounds a stuck call so it fails
# fast instead of hanging the request/UI for the SDK's 600s default.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# dev-prompting solver (small fixed model — measures prompting, not model power)
LLM_PROVIDER=openai
SOLVER_MODEL=gpt-4o-mini
SOLVER_TEMPERATURE=0.2

# spec-design generator (hot, so vague instructions diverge across samples) + judge
# (cold, stable decision extraction). SPEC_SAMPLES = samples generated per evaluation.
SPEC_GEN_MODEL=gpt-4.1-nano
SPEC_GEN_TEMPERATURE=1.3
SPEC_GEN_MAX_TOKENS=800
SPEC_JUDGE_MODEL=gpt-5.4
SPEC_JUDGE_TEMPERATURE=0.0
SPEC_JUDGE_MAX_TOKENS=500
SPEC_SAMPLES=10

# Required admin secret. Empty disables admin access. Configure the SAME value
# in frontend/.env.local; the browser receives a signed HttpOnly session, not this token.
ADMIN_TOKEN=

# Portfolio mode: same-site frontend/API over HTTPS. Local HTTP only: set
# DEMO_COOKIE_SECURE=false. See feature_demo/LIMITS.md before enabling public use.
DEMO_ENABLED=false
DEMO_SESSION_SECONDS=7200
DEMO_COOKIE_SECURE=true
DEMO_JOB_TIMEOUT_SECONDS=900

# Build with docker build -f sandbox.Dockerfile -t gaudi-sandbox:local .
# No host-execution fallback. Only the grader/API host needs Docker access.
SANDBOX_IMAGE=gaudi-sandbox:local

# Public demo limits. Zero budget / empty prices intentionally block paid attempts.
# USD per million tokens for EVERY configured model; fill from your provider pricing.
# JSON shape: {"model-id":{"input":"USD-per-million","output":"USD-per-million"}}
DEMO_LIMITS_ENABLED=true
DEMO_DAILY_BUDGET_USD=0
DEMO_MODEL_PRICES={}
DEMO_MAX_INPUT_TOKENS=65536
DEMO_MAX_OUTPUT_TOKENS=8192
DEMO_MAX_PENDING_JOBS=20
DEMO_MAX_SESSION_JOBS=2
DEMO_MAX_EVALUATIONS=1
DEMO_MAX_SANDBOXES=1
DEMO_JOB_RETRY_LIMIT=1
DEMO_MAX_SAMPLE_RUNS=20
DEMO_SESSION_ISSUES_PER_HOUR=10
# Only proxy peer CIDRs you control (empty ignores X-Forwarded-For).
DEMO_TRUSTED_PROXIES=
