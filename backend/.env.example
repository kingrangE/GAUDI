# Copy to backend/.env and fill in. Never commit the real .env.
# Use the async driver — the backend uses SQLAlchemy create_async_engine.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/and_you

# LLM providers (centralize usage in one backend config module)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Background grading queue (RQ). See docker-compose.yml for a local Redis.
REDIS_URL=redis://localhost:6379/0
