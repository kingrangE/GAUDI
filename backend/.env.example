# Copy to backend/.env and fill in. Never commit the real .env.

# Database — leave unset to use the local SQLite default (sqlite+aiosqlite).
# For Postgres use the async driver:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/and_you

# LLM provider (OpenAI only). All model selection is centralized in app/core/config.py.
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Comma-separated CORS origins for the frontend.
# CORS_ORIGINS=http://localhost:3000

# Background grading queue (RQ). "inline" (default) runs grading in-process;
# "rq" enqueues to an RQ worker via Redis. See docker-compose.yml for a local Redis.
# GRADING_MODE=inline
REDIS_URL=redis://localhost:6379/0
