# Copy to backend/.env and fill in. Never commit the real .env.
DATABASE_URL=postgresql://user:password@localhost:5432/and_you

# LLM providers (centralize usage in one backend config module)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shared LLM seam (llm/config.py)
LLM_PROVIDER=openai

# dev-prompting solver (small fixed model — measures prompting, not model power)
SOLVER_MODEL=gpt-4o-mini
SOLVER_TEMPERATURE=0.2

# spec-design: hot generator (vague instructions diverge) + cold judge + sample count
SPEC_GEN_MODEL=gpt-4.1-nano
SPEC_GEN_TEMPERATURE=1.3
SPEC_GEN_MAX_TOKENS=800
# judge stays reliable (weak judges emit malformed JSON under concurrency)
SPEC_JUDGE_MODEL=gpt-5.4
SPEC_JUDGE_TEMPERATURE=0.0
SPEC_JUDGE_MAX_TOKENS=500
SPEC_SAMPLES=10
