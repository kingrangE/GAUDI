# Copy to frontend/.env.local and adjust. Only NEXT_PUBLIC_* values may be non-secret.
# Base URL of the FastAPI backend the UI talks to.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Enable together with backend DEMO_ENABLED; all API base URLs must use the same
# backend origin so every feature receives the same HttpOnly session cookie.
NEXT_PUBLIC_DEMO_ENABLED=false

# Server-only admin password; same random value as backend ADMIN_TOKEN.
ADMIN_TOKEN=
